# Variables de entorno de la app. En producción se ponen en Coolify
# (pestaña Environment Variables), NUNCA en el repo. Plantilla con las
# variables que el CÓDIGO realmente lee.

# ─── Base de datos ─────────────────────────────────────────────────
# Conexión directa vía @prisma/adapter-pg + prisma.config.ts. Es la ÚNICA
# var de BD que usa el código (DIRECT_URL no se usa).
#  - Local/Supabase: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#  - Coolify: la "Postgres URL interna" del recurso Postgres.
DATABASE_URL=""

# ─── NextAuth (v5) ─────────────────────────────────────────────────
# Secreto de firma de sesión. Obligatorio en producción. openssl rand -base64 32
# (AUTH_SECRET es el nombre nativo de v5; NEXTAUTH_SECRET también vale.)
AUTH_SECRET=""
# URL pública de la app. En prod: la de Coolify y, luego, el dominio.
NEXTAUTH_URL="http://localhost:3000"
# trustHost ya está activado en el código (proxy de Coolify). Alternativa por
# entorno: AUTH_TRUST_HOST=true

# ─── Almacenamiento de ficheros ────────────────────────────────────
# ESTADO ACTUAL: Supabase Storage (bucket privado "invoices").
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# PLAN (tras migrar a Garage/S3 — aún NO conectadas en el código):
#   S3_ENDPOINT="http://garage:3900"
#   S3_REGION="garage"
#   S3_BUCKET="facturas"
#   S3_ACCESS_KEY=""
#   S3_SECRET_KEY=""
#   S3_FORCE_PATH_STYLE="true"

# ─── OCR / IA ──────────────────────────────────────────────────────
# Extractor principal: Gemini.
GEMINI_API_KEY=""
# Modelo (opcional; hay valor por defecto en el código).
GEMINI_MODEL=""
# Fallback: Google Document AI (opcional si hay GEMINI_API_KEY). Service Account
# JSON EN UNA SOLA LÍNEA (no un path), ideal para contenedor.
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=""
GOOGLE_DOCUMENT_AI_LOCATION="eu"

# ─── Resend (emails transaccionales) ───────────────────────────────
# Si vacío, los emails se omiten (no-op). No bloquea el arranque.
RESEND_API_KEY=""
EMAIL_FROM="Asesoría <noreply@tu-dominio.com>"

# ─── Cron jobs ─────────────────────────────────────────────────────
# Protege /api/cron/retry-stuck y /api/cron/closure-reminders. En Coolify no hay
# Vercel Cron: dispáralos con una Scheduled Task enviando
# Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# ─── Bootstrap del primer admin (scripts/bootstrap-admin.mjs) ──────
# Solo se leen al ejecutar el script una vez tras el primer deploy.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
FIRM_NAME=""
FIRM_CIF=""

# NOTA: APP_ENCRYPTION_KEY (del doc de despliegue) NO está implementada: no hay
# cifrado a nivel de campo en el código. El cifrado en reposo depende del disco/BD.
