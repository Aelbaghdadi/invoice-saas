generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  WORKER
  CLIENT
}

enum InvoiceType {
  PURCHASE
  SALE
}

/// Tipo de operación según los códigos que A3 Asesor usa en la columna G
/// del Excel de importación. Sustituye al antiguo `InvoiceScope` con un
/// enum más granular alineado al estándar fiscal.
///
/// Mapeo a códigos numéricos (lo que va al Excel A3):
///   INTERIOR            -> 1
///   AGRARIA             -> 2
///   INTRACOM            -> 3  (compras: adq. intracom. de BIENES; ventas: entrega
///                               intracom., bienes o servicios — ver Invoice.intracomGoodsType)
///   INVERSION_SP        -> 4
///   IMPORTACION         -> 6
///   IVA_NO_DEDUCIBLE    -> 7
///   INTRACOM_SERVICIOS  -> 8  (SOLO compras: adq. intracom. de SERVICIOS)
/// (No hay 5 a propósito — A3 reserva ese código para usos futuros.)
///
/// Detección automática:
///   ES o sin prefijo  -> INTERIOR (default)
///   UE no-ES          -> INTRACOM (se asume bienes; el gestor cambia a
///                        INTRACOM_SERVICIOS a mano si la compra es de servicios)
///   No-UE             -> IMPORTACION
/// Otros tipos los marca el gestor manualmente en revisión, o se aprenden
/// del NIF (AccountEntry.defaultOperationType) la próxima vez.
///
/// INTRACOM_SERVICIOS es exclusivo de compras (ver validators.OPERATION_TYPE_OPTIONS):
/// en ventas la distinción bienes/servicios NO cambia el código de operación
/// (siempre 3), se guarda aparte en Invoice.intracomGoodsType para el modelo 349.
enum OperationType {
  INTERIOR
  AGRARIA
  INTRACOM
  INTRACOM_SERVICIOS
  INVERSION_SP
  IMPORTACION
  IVA_NO_DEDUCIBLE
}

/// Clasificación BIENES/SERVICIOS de una operación intracomunitaria.
/// Compras: la dice el código de operación (INTRACOM = 3 bienes,
/// INTRACOM_SERVICIOS = 8 servicios). Ventas: el código es siempre 3 y la
/// distinción va en la cuenta de ingreso (700 bienes, 705 servicios).
enum IntracomGoodsType {
  BIENES
  SERVICIOS
}

/// De dónde sale la clasificación bienes/servicios de una factura, para que
/// el gestor vea en revisión si la detectó la IA, viene asignada al tercero,
/// se dedujo de la cuenta 700/705 o la marcó a mano.
enum IntracomGoodsSource {
  IA
  TERCERO
  CUENTA
  MANUAL
}

/// Tipo de retención IRPF aplicada en la factura. Determina a qué
/// modelo fiscal alimenta cuando se exporta a A3:
///   PROFESSIONAL -> Modelo 111 (actividades profesionales: abogados,
///                   gestores, programadores freelance...)
///   RENT         -> Modelo 115 (arrendamientos urbanos / locales)
///
/// Default % por tipo: PROFESSIONAL=15 (o 7 nuevos autónomos),
///                     RENT=19.
enum RetentionType {
  PROFESSIONAL
  RENT
}

/// Tipo de rectificativa según la lógica A3:
///   BY_DIFFERENCE   -> Por diferencias: se registra solo el importe
///                      de la variación (delta sobre la original).
///   BY_SUBSTITUTION -> Por sustitución: se anula la anterior y se
///                      emite una nueva con los datos correctos.
enum RectificativeType {
  BY_DIFFERENCE
  BY_SUBSTITUTION
}

enum PeriodType {
  MONTHLY
  QUARTERLY
}

enum InvoiceStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  PENDING_REVIEW
  NEEDS_ATTENTION
  OCR_ERROR
  VALIDATED
  REJECTED
  EXPORTED
  /// Foto original que contenía varios tickets y fue dividida en sub-facturas.
  /// Se excluye de la cola activa pero se conserva para referencia.
  SPLIT_SOURCE
  /// Subida en modo "clasificar entre varios": pendiente de auto-ruteo por CIF
  /// o de clasificación manual. Vive en el cliente buzón "Sin clasificar" hasta
  /// que se asigna a su cliente real. Se excluye de colas/contadores normales.
  PENDING_ROUTING
}

enum RejectionCategory {
  ILLEGIBLE
  INCOMPLETE
  WRONG_PERIOD
  DUPLICATE
  OTHER
}

enum IssueType {
  OCR_FAILED
  LOW_CONFIDENCE
  POSSIBLE_DUPLICATE
  MATH_MISMATCH
  MANUAL
}

enum IssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ─── Archivo de facturas ─────────────────────────────────────────────────────

/// Original de la factura (RD 1619/2012, arts. 19 y 21).
/// ELECTRONIC: llegó en electrónico (PDF nacido digital, XML, Word…). Ese
/// fichero es el original y se conserva en su formato.
/// PAPER: el original es un papel. En la app hay su escaneo o su foto, que no
/// es una digitalización certificada: el papel hay que guardarlo.
/// null («Por confirmar»): un escaneo o una foto que llegó fuera de un taco.
/// Puede ser el original electrónico (un PDF escaneado que manda el proveedor
/// por correo, RD 1619/2012, art. 9) o la copia de un papel: la app no lo sabe.
enum OriginalMedium {
  ELECTRONIC
  PAPER
}

/// Quién decidió el medio.
/// - AUTO: la app (tipo de fichero, capa de texto del PDF, la migración o la
///   herencia de una división cuyo medio era automático).
/// - TACO: la factura se subió en una tanda de papel, o la tanda se convirtió en taco.
/// - MANUAL: una persona, o se adjuntó un original en otro formato.
/// El análisis solo escribe cuando está vacío o es AUTO.
enum OriginalMediumSource {
  AUTO
  TACO
  MANUAL
}

/// Por qué se conserva más del mínimo (6 años desde el cierre del ejercicio):
/// inmovilizado, bases negativas o deducciones pendientes (LGT 66 bis y 70.3),
/// inspección o pleito, u otro motivo.
enum RetentionHoldReason {
  FIXED_ASSET
  TAX_CREDITS
  INSPECTION
  OTHER
}

/// UPLOAD: un «Subir» del gestor.
/// ARCHIVE: papel que ya existía y se ubica a mano desde el archivo (taco sin páginas).
enum UploadBatchOrigin {
  UPLOAD
  ARCHIVE
}

model AdvisoryFirm {
  id        String   @id @default(cuid())
  name      String
  cif       String   @unique
  /// Logo de la asesoría como data URL (PNG, redimensionado en cliente a
  /// ~320px para que pese poco). Se muestra arriba a la izquierda en la barra
  /// lateral. null = se usa la marca por defecto (Faktury).
  logoDataUrl String? @db.Text
  /// Asesoría de demostración. Solo se marca a mano en la BD, nunca desde la
  /// app ni desde un script. Los triggers de la migración 12 solo dejan borrar
  /// facturas y documentos de estas asesorías, y reseedDemo lo comprueba antes
  /// de tocar nada.
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  clients Client[]
  clientGroups ClientGroup[]
  providerRoutingRules ProviderRoutingRule[]
  supportTickets SupportTicket[]
  uploadBatches UploadBatch[]
}

model User {
  id             String    @id @default(cuid())
  /// Identificador de acceso. Se inicia sesión con `username`, no con email.
  username       String    @unique
  email          String    @unique
  passwordHash   String
  name           String
  role           Role
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  advisoryFirmId String?
  advisoryFirm   AdvisoryFirm? @relation(fields: [advisoryFirmId], references: [id])

  assignedClients WorkerClientAssignment[]
  clientProfile   Client?                  @relation("ClientUser")
  auditLogs       AuditLog[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]
}

model Client {
  id                String   @id @default(cuid())
  name              String
  cif               String   @unique
  /// Solo si el cliente tiene acceso al portal. Sin acceso no hay email y la
  /// columna queda a NULL (el unique de Postgres admite varios NULL).
  email             String?  @unique
  accountingProgram String?
  exportConfig      Json?     // { encoding, delimiter, dateFormat, accountLength }
  /// Cuenta de proveedor por defecto para facturas simplificadas / tickets
  /// sin datos suficientes (ej. "4999999"). El gestor la aplica manualmente
  /// desde revisión para agrupar esos tickets en una sola cuenta.
  simplifiedSupplierAccount String?
  /// Cuenta de gasto por defecto para esas mismas facturas simplificadas.
  simplifiedExpenseAccount  String?
  /// true si este cliente es un comerciante minorista acogido a Recargo de
  /// Equivalencia: sus facturas (recibidas y emitidas) pueden llevar % y
  /// cuota de recargo ademas del IVA normal. Solo se sugiere automaticamente
  /// el recargo (ver processInvoice) cuando este flag esta activo — nunca
  /// por el simple hecho de que el IVA sea 21/10/4.
  equivalenceSurchargeCustomer Boolean @default(false)
  /// true solo para el cliente técnico "Sin clasificar" de cada asesoría, que
  /// sostiene las facturas subidas en modo clasificar mientras se rutean. Se
  /// excluye de selectores, listados, colas y exportación.
  isUnclassifiedBucket Boolean @default(false)
  /// Ficha del cliente: la persona de contacto y su teléfono no dan acceso al
  /// portal (eso es `email` + `user`); son para que el gestor sepa a quién
  /// llamar. Las notas son internas de la asesoría: el cliente no las ve.
  contactName String?
  phone       String?
  notes       String? @db.Text
  /// Mes (1-12) en que empieza su ejercicio; 1 = año natural. Agrupa el
  /// archivo y fija «conservar hasta». No cambia los números de registro, que
  /// van por año natural (el del IVA). El rango se valida con zod en Ajustes.
  fiscalYearStartMonth Int @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  advisoryFirmId String
  advisoryFirm   AdvisoryFirm @relation(fields: [advisoryFirmId], references: [id])

  userId String? @unique
  user   User?   @relation("ClientUser", fields: [userId], references: [id])

  assignedWorkers WorkerClientAssignment[]
  documents       Document[]
  invoices        Invoice[]
  periodClosures  PeriodClosure[]
  accountEntries  AccountEntry[]
  groupMemberships ClientGroupMember[]
  providerRoutingRules ProviderRoutingRule[]
  uploadBatches   UploadBatch[]
  registerSeries  InvoiceRegisterSeries[]
}

/// Aprendizaje de ruteo por proveedor. Cuando el gestor clasifica a mano una
/// factura "por clasificar" cuyo OTRO lado (proveedor en compras / cliente en
/// ventas) tiene CIF, se recuerda a qué empresa la asignó, para auto-rutear las
/// siguientes de ese mismo proveedor. Si el mismo proveedor se clasifica a dos
/// empresas distintas, se marca `ambiguous` y deja de auto-rutear.
model ProviderRoutingRule {
  id             String   @id @default(cuid())
  advisoryFirmId String
  advisoryFirm   AdvisoryFirm @relation(fields: [advisoryFirmId], references: [id], onDelete: Cascade)
  /// CIF de la otra parte (proveedor), normalizado (sin prefijo país ni separadores).
  providerNif    String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// true si el proveedor se ha visto en >1 empresa: ya no auto-rutea.
  ambiguous      Boolean  @default(false)
  hitCount       Int      @default(1)
  lastSeenAt     DateTime @default(now())

  @@unique([advisoryFirmId, providerNif])
  @@index([advisoryFirmId])
  @@index([clientId])
}

/// Grupo de clientes (empresas) que un gestor sube juntos para auto-ruteo por
/// CIF. Ej: un dueño con 3 restaurantes que pasa todas las facturas mezcladas.
/// Cuelga de la asesoría (multitenancy).
model ClientGroup {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advisoryFirmId String
  advisoryFirm   AdvisoryFirm @relation(fields: [advisoryFirmId], references: [id], onDelete: Cascade)

  members ClientGroupMember[]

  @@index([advisoryFirmId])
}

model ClientGroupMember {
  id      String @id @default(cuid())
  groupId String
  group   ClientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([groupId, clientId])
  @@index([clientId])
}

model WorkerClientAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  workerId String
  worker   User   @relation(fields: [workerId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([workerId, clientId])
}

model Document {
  id         String   @id @default(cuid())
  filename   String
  storageKey String
  fileType   String
  fileHash   String?
  sizeBytes  Int?
  uploadedBy String?
  createdAt  DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invoices Invoice[]
  /// Filas de archivo cuyo original es este documento (un Word adjunto).
  archiveOriginals InvoiceArchive[]
}

model Invoice {
  id          String        @id @default(cuid())
  filename    String
  storageKey  String
  fileType    String
  fileHash    String?
  type        InvoiceType
  /// true si la factura se subió como "No lo sé" (tipo sin determinar). El
  /// OCR intenta detectarlo por el lado donde aparece el CIF del cliente
  /// (receptor -> compra, emisor -> venta) y el gestor lo confirma en la
  /// revisión. Mientras tanto `type` es un valor provisional (placeholder).
  typeUnconfirmed Boolean @default(false)
  status      InvoiceStatus @default(UPLOADED)
  /// Tipo de operación fiscal. Determina la columna G del Excel A3.
  /// Por defecto INTERIOR; se cambia automáticamente si el NIF del
  /// emisor tiene prefijo no-ES, o manualmente por el gestor.
  operationType OperationType @default(INTERIOR)
  /// Prefijo VAT del pais del emisor ("ES", "DE", "FR"...) o null si no se
  /// detecto prefijo y se asume nacional. OJO: es el prefijo VAT, no el
  /// codigo ISO — Grecia es "EL", no "GR", y asi lo quieren A3 y VIES.
  issuerCountry   String?   @db.Char(2)
  /// Codigo ISO del pais del receptor, analogo a issuerCountry.
  receiverCountry String?   @db.Char(2)
  periodType  PeriodType @default(MONTHLY)
  periodMonth Int
  periodYear  Int

  // Datos finales (editados por gestor o copiados de OCR)
  issuerName    String?
  issuerCif     String?
  receiverName  String?
  receiverCif   String?
  invoiceNumber String?
  invoiceDate   DateTime?
  taxBase       Decimal?  @db.Decimal(12, 2)
  vatRate       Decimal?  @db.Decimal(5, 2)
  vatAmount     Decimal?  @db.Decimal(12, 2)
  irpfRate      Decimal?  @db.Decimal(5, 2)
  irpfAmount    Decimal?  @db.Decimal(12, 2)
  /// Tipo de retención IRPF aplicada (Modelo 111 vs 115). null si la
  /// factura no lleva retención.
  retentionType RetentionType?
  /// Base sobre la que se calcula la retención. Normalmente coincide
  /// con `taxBase` pero a veces el alcance es distinto, asi que lo
  /// almacenamos por separado.
  retentionBase Decimal?  @db.Decimal(12, 2)
  totalAmount   Decimal?  @db.Decimal(12, 2)
  /// Moneda ISO 4217 de los importes segun el OCR. null = no detectada (se
  /// tratan como euros). A3 solo admite euros: cualquier otra se avisa en
  /// revision y en el export hasta que el gestor convierta los importes.
  currency      String?   @db.Char(3)
  /// Intracomunitarias: BIENES o SERVICIOS. En compras va a la par del
  /// código de operación (3/8); en ventas decide la cuenta de ingreso
  /// (700/705). null = no aplica o sin determinar (una venta intracomunitaria
  /// sin clasificar no se puede validar).
  intracomGoodsType   IntracomGoodsType?
  /// Origen de intracomGoodsType: IA, tercero, cuenta o a mano.
  intracomGoodsSource IntracomGoodsSource?
  isValid       Boolean?

  // ── Factura rectificativa (abono / corrección) ─────────────────────
  /// true si esta factura RECTIFICA una anterior. Las rectificativas
  /// suelen tener líneas con importe negativo o total negativo. Se
  /// detecta automáticamente del OCR (línea IVA con base negativa) o
  /// el gestor lo marca manualmente.
  isRectificative        Boolean   @default(false)
  /// Serie de la factura original que se está rectificando.
  /// Ej: "F24" si la original era "F24-001".
  rectifiedInvoiceSeries String?
  /// Número de la factura original. Ej: "F24-001".
  rectifiedInvoiceNumber String?
  /// Tipo de rectificación. Lo pide A3 en la columna "Tipo Rectificativa"
  /// si exportamos a un mapping extendido.
  rectificativeType      RectificativeType?
  /// Casos especiales: concursos de acreedores o créditos incobrables
  /// (Art. 80.Tres de la Ley del IVA). Muy raro pero hay que tenerlo.
  art80Tres              Boolean   @default(false)

  // Cuentas contables asignadas (del plan de cuentas)
  supplierAccount String?   // Cuenta proveedor 400.xxxxx / 410.xxxxx
  expenseAccount  String?   // Cuenta gasto/ingreso 6xx.xxxxx / 7xx.xxxxx

  // Gestion de estado avanzada
  rejectionReason   String?
  rejectionCategory RejectionCategory?
  reviewedBy        String?

  // Re-subida: vincula con la factura rechazada original
  replacesId String?  @unique
  replaces   Invoice? @relation("ReplacedBy", fields: [replacesId], references: [id])
  replacedBy Invoice? @relation("ReplacedBy")

  // División multi-ticket: la sub-factura apunta a la foto original (SPLIT_SOURCE)
  splitFromId String?
  splitFrom   Invoice?  @relation("SplitFrom", fields: [splitFromId], references: [id])
  splitInvoices Invoice[] @relation("SplitFrom")

  // Periodo contable (puede diferir del periodo de subida)
  accountingPeriodMonth Int?
  accountingPeriodYear  Int?
  ocrAttempts     Int       @default(0)
  lastOcrError    String?

  /// Marca de "posponer": el gestor decidió saltarse esta factura para
  /// más tarde sin cambiar su estado. La cola de revisión ordena las
  /// pospuestas al final, así no estorban al flujo principal. Se limpia
  /// automáticamente cuando alguien la edita o valida.
  deferredAt    DateTime?

  /// Auto-ruteo multicliente: ids de los clientes candidatos del lote contra
  /// cuyos CIF se intenta casar la factura. Solo tiene valor mientras está en
  /// el buzón (PENDING_ROUTING); se limpia al rutear/clasificar.
  routingCandidateIds String[] @default([])
  /// Motivo por el que quedó "Por clasificar" (no_cif / no_match / ambiguous).
  routingReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId      String
  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  documentId    String?
  document      Document?  @relation(fields: [documentId], references: [id])

  auditLogs     AuditLog[]
  extractions   InvoiceExtraction[]
  statusHistory InvoiceStatusHistory[]
  issues        InvoiceIssue[]
  exportBatchItems ExportBatchItem[]
  vatLines      InvoiceVatLine[]

  exportBatchId String?
  exportBatch   ExportBatch? @relation(fields: [exportBatchId], references: [id])

  /// Su fila del archivo. La crea el trigger invoice_archive_row al insertar
  /// la factura: no uséis archive: { create }.
  archive InvoiceArchive?

  @@index([clientId, status])
  @@index([issuerCif])
  @@index([periodMonth, periodYear])
  @@index([splitFromId]) // familia de una división
}

/// Desglose de bases/cuotas de IVA. Una factura puede tener varias lineas
/// (p.ej. supermercado: 4% + 10% + 21%). Los campos taxBase/vatAmount de
/// Invoice son la SUMA de las lineas (denormalizados para listados).
/// Invoice.vatRate solo tiene valor cuando hay una unica linea.
model InvoiceVatLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  position  Int      // orden de presentacion (0,1,2...)
  taxBase   Decimal  @db.Decimal(12, 2)
  vatRate   Decimal  @db.Decimal(5, 2)
  vatAmount Decimal  @db.Decimal(12, 2)
  /// % y cuota de Recargo de Equivalencia de ESTA linea (recibidas y
  /// emitidas de clientes minoristas acogidos a RE, ver
  /// Client.equivalenceSurchargeCustomer). Va por linea de IVA, no por
  /// factura: cada tipo (21/10/4) tiene su propio
  /// recargo, y una linea concreta (p.ej. portes) puede no llevarlo aunque el
  /// resto de la factura si. null = esta linea no lleva recargo — NO
  /// confundir con 0.
  equivalenceSurchargeRate   Decimal? @db.Decimal(5, 2)
  equivalenceSurchargeAmount Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceExtraction {
  id        String @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Datos brutos extraidos por OCR
  rawResponse   String?   // JSON completo de respuesta OCR
  source        String    // "document_ai" | "xml_parse" | "manual"
  confidence    Json?     // { campo: 0.0-1.0 } scores de confianza OCR

  // OCR job tracking
  ocrStartedAt  DateTime?  // Inicio del procesamiento OCR
  ocrFinishedAt DateTime?  // Fin del procesamiento (exito o error)
  ocrDurationMs Int?       // Duracion en milisegundos
  isReprocess   Boolean    @default(false) // true si fue reproceso manual
  issuerName    String?
  issuerCif     String?
  receiverName  String?
  receiverCif   String?
  invoiceNumber String?
  invoiceDate   DateTime?
  taxBase       Decimal?  @db.Decimal(12, 2)
  vatRate       Decimal?  @db.Decimal(5, 2)
  vatAmount     Decimal?  @db.Decimal(12, 2)
  irpfRate      Decimal?  @db.Decimal(5, 2)
  irpfAmount    Decimal?  @db.Decimal(12, 2)
  totalAmount   Decimal?  @db.Decimal(12, 2)
  isValid       Boolean?

  createdAt DateTime @default(now())
}

model InvoiceStatusHistory {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  fromStatus InvoiceStatus?
  toStatus   InvoiceStatus
  reason     String?
  changedBy  String?

  createdAt DateTime @default(now())
}

model ExportBatch {
  id           String     @id @default(cuid())
  format       String     // "sage50" | "contasol" | "a3con"
  clientId     String?
  periodType   PeriodType @default(MONTHLY)
  periodMonth  Int?
  periodYear   Int?
  invoiceType  String?    // "ALL" | "PURCHASE" | "SALE"
  invoiceCount Int
  userId       String
  createdAt    DateTime   @default(now())

  invoices Invoice[]
  items    ExportBatchItem[]
}

model ExportBatchItem {
  id            String      @id @default(cuid())
  exportBatchId String
  exportBatch   ExportBatch @relation(fields: [exportBatchId], references: [id], onDelete: Restrict)
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  snapshot      String      // JSON snapshot de los datos de la factura al exportar
  createdAt     DateTime    @default(now())

  @@unique([exportBatchId, invoiceId])
}

model InvoiceIssue {
  id          String      @id @default(cuid())
  invoiceId   String
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  type        IssueType
  status      IssueStatus @default(OPEN)
  description String
  field       String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
}

/// Registro de cambios append-only con cadena de hash.
///
/// Cada registro contiene el hash del anterior (`prevHash`) y su propio
/// hash (`hash`). Si alguien borra o modifica una fila — incluso desde
/// la consola de Supabase — la cadena se rompe y `verifyAuditChain()`
/// lo detecta inmediatamente.
///
/// Ademas hay un trigger PostgreSQL que bloquea UPDATE/DELETE a nivel
/// BD (ver migracion). Por eso los desarrolladores tampoco pueden
/// alterar el historial.
model AuditLog {
  id        String   @id @default(cuid())
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// id del registro anterior en la cadena. NULL solo para el primero
  /// de cada factura ("genesis" del chain por factura).
  prevId    String?
  /// Hash del registro anterior. "GENESIS" para el primero.
  prevHash  String   @default("GENESIS")
  /// Hash de este registro (sha256 hex de los campos + prevHash).
  hash      String

  @@index([invoiceId, createdAt])
  @@index([prevId])
}

model PeriodClosure {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  closedBy    String
  closedAt    DateTime @default(now())
  reopenedAt  DateTime?
  reopenedBy  String?
  reminderSent Boolean @default(false)

  @@unique([clientId, month, year])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AccountEntry {
  id              String   @id @default(cuid())
  nif             String
  name            String
  /// Cuentas por SENTIDO, no por fila: en A3 el mismo tercero puede tener
  /// ficha de proveedor (40x/41x) y de cliente (43x) a la vez — FARMACIA
  /// AGUACATE CB, E87329710, es 41000486 comprando y 43000053 vendiendo.
  /// Con una sola pareja, la ultima cuenta que entraba pisaba a la otra y el
  /// autorelleno se quedaba en blanco una factura si y otra tambien.
  /// "" (no null) = sin cuenta para ese sentido, que es lo que ya usaba el
  /// aprendizaje al validar.
  supplierAccount String   @default("") // Cuenta proveedor 400.xxxxx / 410.xxxxx
  customerAccount String   @default("") // Cuenta cliente 430.xxxxx
  expenseAccount  String   @default("") // Cuenta gasto 6xx.xxxxx (o contrapartida 2xx/3xx)
  incomeAccount   String   @default("") // Cuenta ingreso 7xx.xxxxx
  defaultVatRate  Decimal? @db.Decimal(5, 2)
  /// Tipo de operación fiscal por defecto para este NIF. Se aprende al
  /// validar la primera factura: si el gestor cambia el tipo (ej. detecta
  /// que es Inversión SP), la próxima factura del mismo NIF la
  /// pre-rellena automáticamente. null = sin aprender aún.
  defaultOperationType OperationType?
  /// Tipo y % de retención IRPF aprendidos de validaciones previas.
  /// Si un proveedor SIEMPRE emite con retención de profesional al 15%,
  /// la próxima factura suya se pre-rellena con esos valores.
  defaultRetentionType RetentionType?
  defaultRetentionRate Decimal?       @db.Decimal(5, 2)
  /// Bienes o servicios asignado "siempre" a este tercero en intracomunitarias,
  /// por sentido: la fila es la misma si el tercero es proveedor y cliente a
  /// la vez, y puede vendernos bienes y comprarnos servicios. Solo se guarda
  /// cuando el gestor lo confirma al validar y manda sobre lo que detecte la
  /// IA. null = sin asignar.
  intracomGoodsTypePurchase IntracomGoodsType?
  intracomGoodsTypeSale     IntracomGoodsType?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Una sola fila por tercero, con el sentido en columnas. Partirla en dos
  // filas (una de compras y otra de ventas) duplicaria nombre, % de IVA,
  // tipo de operacion y retencion, que no dependen del sentido.
  @@unique([clientId, nif])
  @@index([clientId])
}

// ─── Archivo de facturas ─────────────────────────────────────────────────────
// Sin índices parciales, de expresión ni CHECK: Prisma propondría borrarlos.
// Las funciones y los triggers del archivo están al final de la migración
// 00000000000012_archivo.

/// Archivo de una factura (una fila por factura).
/// Va en una tabla aparte a propósito:
/// - lo que se cambia aquí no toca Invoice.updatedAt, que es el testigo de
///   guardar, validar, rechazar, dividir y exportar;
/// - se puede cambiar con el periodo cerrado o con la factura ya exportada.
/// La fila la crea el trigger invoice_archive_row al insertar la factura (también
/// con createMany). No uséis archive: { create } anidado: la fila se rellena con
/// update en la misma transacción. Un trigger impide borrarla mientras exista su
/// factura, y otro, cambiar el nº de registro o la tanda de llegada.
model InvoiceArchive {
  invoiceId String  @id
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Llegada a la asesoría:
  /// - en una tanda, la fecha de creación de la tanda;
  /// - sin tanda, la de la factura;
  /// - las partes de una división, la de su original.
  /// Con el RD 238 será la fecha de recepción en la plataforma.
  receivedAt DateTime @default(now())

  /// Tanda de LLEGADA y posición en su lista (1..fileCount). Se fijan en el alta
  /// y no cambian. En un taco, la posición es la página. Las partes de una
  /// división comparten tanda y posición.
  uploadBatchId  String?
  uploadBatch    UploadBatch? @relation("ArrivalBatch", fields: [uploadBatchId], references: [id], onDelete: Restrict)
  uploadPosition Int?
  /// 0 = el documento subido; 1..n = partes de una división (mismo papel),
  /// numeradas por la raíz de la división.
  splitPart      Int          @default(0)
  /// Taco donde se guarda el papel cuando no es el de llegada (papel anterior al
  /// archivo o de una tanda digital). La ubicación es la de paperBatch si la hay;
  /// si no, la de uploadBatch cuando es un taco. Puesto, no vuelve a vacío.
  paperBatchId   String?
  paperBatch     UploadBatch? @relation("PaperBatch", fields: [paperBatchId], references: [id], onDelete: Restrict)
  /// El papel lo tiene el cliente. La app solo lo marca en lo que sube un
  /// usuario CLIENT (portal) y en su resubida; lo demás, a mano.
  paperHeldByClient Boolean @default(false)

  /// null = «Por confirmar» (ver OriginalMedium).
  originalMedium       OriginalMedium?
  originalMediumSource OriginalMediumSource?
  /// Código del motivo: xml, pdf_text, scan_unconfirmed, image_unconfirmed,
  /// pdf_unreadable, backfill_pending (PDF anterior al archivo, pendiente de
  /// detectar), split, taco, other_format o manual. Las etiquetas están en
  /// src/lib/originalMedium.ts.
  originalMediumReason String?
  /// Producer o Creator del PDF, para afinar la lista de escáneres.
  pdfProducer          String?

  /// Original en otro formato (.doc, .docx, .xls…) cuando la app lee su PDF.
  /// Se puede quitar (vuelve a null, con auditoría); el Document se queda.
  originalDocumentId String?
  originalDocument   Document? @relation(fields: [originalDocumentId], references: [id], onDelete: Restrict)

  /// Nº de registro del archivo: serie (cliente, tipo y año) y número. Se pone la
  /// primera vez que la factura sale en un Excel de A3 y no cambia (lo impide un trigger).
  registerSeriesId String?
  registerSeries   InvoiceRegisterSeries? @relation(fields: [registerSeriesId], references: [id], onDelete: Restrict)
  registerNumber   Int?
  registeredAt     DateTime?

  /// «Conservar más»: sin fecha de fin hasta que alguien lo desmarque.
  retentionHold       Boolean              @default(false)
  retentionHoldReason RetentionHoldReason?
  retentionHoldNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([registerSeriesId, registerNumber])
  @@unique([uploadBatchId, uploadPosition, splitPart])
  @@index([paperBatchId])
  @@index([originalDocumentId])
}

/// Tanda: cada «Subir» del gestor, o el papel antiguo que se ubica a mano.
/// Fija la llegada y el orden de sus facturas.
/// Si tiene tacoNumber es un TACO (papel escaneado en la asesoría): se numera por
/// asesoría al crearlo, y la caja es una etiqueta que se pone al guardarlo.
/// Cuelga de la asesoría (multitenancy).
model UploadBatch {
  id             String            @id @default(cuid())
  advisoryFirmId String
  advisoryFirm   AdvisoryFirm      @relation(fields: [advisoryFirmId], references: [id], onDelete: Cascade)
  /// null = «Clasificar entre varios»: puede mezclar empresas.
  clientId       String?
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  origin         UploadBatchOrigin @default(UPLOAD)
  /// Quién la creó. Sin clave foránea, como ExportBatch.userId.
  createdById    String
  /// Ficheros de la lista al pulsar «Subir»: posiciones 1..fileCount.
  fileCount      Int
  /// Lote declarado; /api/uploads lo exige en cada fichero. En ARCHIVE solo se guarda el año.
  periodType     PeriodType?
  periodMonth    Int?
  periodYear     Int
  /// PURCHASE, SALE o UNKNOWN, como en el formulario; null en ARCHIVE.
  invoiceType    String?
  /// Nº de taco, correlativo por asesoría («Taco 37»); null = tanda digital.
  /// Puesto, no cambia (lo impide un trigger).
  tacoNumber     Int?
  /// Destino del papel al guardarlo: una caja (etiqueta) o devuelto al cliente.
  boxLabel       String?
  returnedAt     DateTime?
  filedAt        DateTime?
  filedById      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  /// Facturas que llegaron en esta tanda.
  archives      InvoiceArchive[] @relation("ArrivalBatch")
  /// Papel guardado en este taco sin haber llegado en él.
  paperArchives InvoiceArchive[] @relation("PaperBatch")

  @@unique([advisoryFirmId, tacoNumber])
  @@index([advisoryFirmId, filedAt])
  @@index([advisoryFirmId, boxLabel])
  @@index([clientId, createdAt])
}

/// Último nº de registro por cliente, tipo (PURCHASE = serie R, SALE = serie E)
/// y año natural del periodo de deducción. Solo sube.
/// Se reserva con INSERT … ON CONFLICT DO UPDATE … RETURNING, que bloquea la
/// fila hasta el COMMIT. Lo ya exportado se numera en la migración.
model InvoiceRegisterSeries {
  id         String      @id @default(cuid())
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       InvoiceType
  year       Int
  lastNumber Int         @default(0)
  updatedAt  DateTime    @updatedAt

  archives InvoiceArchive[]

  @@unique([clientId, type, year])
}

// ─── Soporte ─────────────────────────────────────────────────────────────────

enum SupportTicketType {
  BUG
  SUGGESTION
  QUESTION
  OTHER
}

/// Quién abrió el ticket: una persona de la asesoría, o la propia app al
/// detectar un error inesperado (ver src/lib/autoTickets.ts).
enum SupportTicketSource {
  USER
  AUTO
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Un aviso de la asesoría al equipo del producto: un fallo, una sugerencia o
/// una consulta. Cuelga de la asesoría (multitenancy); el equipo de soporte
/// (usuarios de SUPPORT_USERNAMES) ve los de todas. El primer mensaje es la
/// descripción con la que se abrió.
model SupportTicket {
  id             String              @id @default(cuid())
  /// En los automáticos puede faltar: un error sin sesión (el login, un cron).
  advisoryFirmId String?
  advisoryFirm   AdvisoryFirm?       @relation(fields: [advisoryFirmId], references: [id], onDelete: Cascade)
  /// En los automáticos, quien se encontró el error (si había sesión).
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id])
  source         SupportTicketSource @default(USER)
  /// Huella del error (automáticos): el mismo fallo suma una vez más al
  /// ticket que siga sin cerrar en vez de abrir otro.
  fingerprint    String?
  occurrences    Int                 @default(1)
  lastSeenAt     DateTime?
  type           SupportTicketType
  status         SupportTicketStatus @default(OPEN)
  subject        String
  /// Desde dónde se abrió (ruta de la app sin parámetros) y con qué navegador:
  /// contexto para reproducir un fallo. Nada personal.
  pageUrl        String?
  userAgent      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  resolvedAt     DateTime?

  messages SupportMessage[]

  @@index([advisoryFirmId, status, updatedAt])
  @@index([status, updatedAt])
  @@index([fingerprint, status])
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// null: lo ha escrito la app (el detalle de un ticket automático).
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id])
  /// true si lo escribe el equipo de soporte; false si lo escribe la asesoría.
  fromSupport Boolean       @default(false)
  body        String        @db.Text
  /// Una captura o un PDF adjunto, en el almacenamiento (support/...).
  attachmentKey  String?
  attachmentName String?
  attachmentType String?
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
}
