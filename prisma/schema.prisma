generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  WORKER
  CLIENT
}

enum InvoiceType {
  PURCHASE
  SALE
}

/// Tipo de operación según los códigos que A3 Asesor usa en la columna G
/// del Excel de importación. Sustituye al antiguo `InvoiceScope` con un
/// enum más granular alineado al estándar fiscal.
///
/// Mapeo a códigos numéricos (lo que va al Excel A3):
///   INTERIOR        -> 1
///   AGRARIA         -> 2
///   INTRACOM        -> 3
///   INVERSION_SP    -> 4
///   IMPORTACION     -> 6
///   IVA_NO_DEDUCIBLE -> 7
/// (No hay 5 a propósito — A3 reserva ese código para usos futuros.)
///
/// Detección automática:
///   ES o sin prefijo  -> INTERIOR (default)
///   UE no-ES          -> INTRACOM
///   No-UE             -> IMPORTACION
/// Otros tipos los marca el gestor manualmente en revisión, o se aprenden
/// del NIF (AccountEntry.defaultOperationType) la próxima vez.
enum OperationType {
  INTERIOR
  AGRARIA
  INTRACOM
  INVERSION_SP
  IMPORTACION
  IVA_NO_DEDUCIBLE
}

/// Tipo de retención IRPF aplicada en la factura. Determina a qué
/// modelo fiscal alimenta cuando se exporta a A3:
///   PROFESSIONAL -> Modelo 111 (actividades profesionales: abogados,
///                   gestores, programadores freelance...)
///   RENT         -> Modelo 115 (arrendamientos urbanos / locales)
///
/// Default % por tipo: PROFESSIONAL=15 (o 7 nuevos autónomos),
///                     RENT=19.
enum RetentionType {
  PROFESSIONAL
  RENT
}

/// Tipo de rectificativa según la lógica A3:
///   BY_DIFFERENCE   -> Por diferencias: se registra solo el importe
///                      de la variación (delta sobre la original).
///   BY_SUBSTITUTION -> Por sustitución: se anula la anterior y se
///                      emite una nueva con los datos correctos.
enum RectificativeType {
  BY_DIFFERENCE
  BY_SUBSTITUTION
}

enum InvoiceStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  PENDING_REVIEW
  NEEDS_ATTENTION
  OCR_ERROR
  VALIDATED
  REJECTED
  EXPORTED
}

enum RejectionCategory {
  ILLEGIBLE
  INCOMPLETE
  WRONG_PERIOD
  DUPLICATE
  OTHER
}

enum IssueType {
  OCR_FAILED
  LOW_CONFIDENCE
  POSSIBLE_DUPLICATE
  MATH_MISMATCH
  MANUAL
}

enum IssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model AdvisoryFirm {
  id        String   @id @default(cuid())
  name      String
  cif       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  clients Client[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           Role
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  advisoryFirmId String?
  advisoryFirm   AdvisoryFirm? @relation(fields: [advisoryFirmId], references: [id])

  assignedClients WorkerClientAssignment[]
  clientProfile   Client?                  @relation("ClientUser")
  auditLogs       AuditLog[]
}

model Client {
  id                String   @id @default(cuid())
  name              String
  cif               String   @unique
  email             String   @unique
  accountingProgram String?
  exportConfig      Json?     // { encoding, delimiter, dateFormat, accountLength }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  advisoryFirmId String
  advisoryFirm   AdvisoryFirm @relation(fields: [advisoryFirmId], references: [id])

  userId String? @unique
  user   User?   @relation("ClientUser", fields: [userId], references: [id])

  assignedWorkers WorkerClientAssignment[]
  documents       Document[]
  invoices        Invoice[]
  periodClosures  PeriodClosure[]
  accountEntries  AccountEntry[]
}

model WorkerClientAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  workerId String
  worker   User   @relation(fields: [workerId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([workerId, clientId])
}

model Document {
  id         String   @id @default(cuid())
  filename   String
  storageKey String
  fileType   String
  fileHash   String?
  sizeBytes  Int?
  uploadedBy String?
  createdAt  DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invoices Invoice[]
}

model Invoice {
  id          String        @id @default(cuid())
  filename    String
  storageKey  String
  fileType    String
  fileHash    String?
  type        InvoiceType
  status      InvoiceStatus @default(UPLOADED)
  /// Tipo de operación fiscal. Determina la columna G del Excel A3.
  /// Por defecto INTERIOR; se cambia automáticamente si el NIF del
  /// emisor tiene prefijo no-ES, o manualmente por el gestor.
  operationType OperationType @default(INTERIOR)
  /// Codigo ISO del pais del emisor ("ES", "DE", "FR"...) o null si
  /// no se detecto prefijo y se asume nacional.
  issuerCountry String?     @db.Char(2)
  periodMonth Int
  periodYear  Int

  // Datos finales (editados por gestor o copiados de OCR)
  issuerName    String?
  issuerCif     String?
  receiverName  String?
  receiverCif   String?
  invoiceNumber String?
  invoiceDate   DateTime?
  taxBase       Decimal?  @db.Decimal(12, 2)
  vatRate       Decimal?  @db.Decimal(5, 2)
  vatAmount     Decimal?  @db.Decimal(12, 2)
  irpfRate      Decimal?  @db.Decimal(5, 2)
  irpfAmount    Decimal?  @db.Decimal(12, 2)
  /// Tipo de retención IRPF aplicada (Modelo 111 vs 115). null si la
  /// factura no lleva retención.
  retentionType RetentionType?
  /// Base sobre la que se calcula la retención. Normalmente coincide
  /// con `taxBase` pero a veces el alcance es distinto, asi que lo
  /// almacenamos por separado.
  retentionBase Decimal?  @db.Decimal(12, 2)
  totalAmount   Decimal?  @db.Decimal(12, 2)
  isValid       Boolean?

  // ── Factura rectificativa (abono / corrección) ─────────────────────
  /// true si esta factura RECTIFICA una anterior. Las rectificativas
  /// suelen tener líneas con importe negativo o total negativo. Se
  /// detecta automáticamente del OCR (línea IVA con base negativa) o
  /// el gestor lo marca manualmente.
  isRectificative        Boolean   @default(false)
  /// Serie de la factura original que se está rectificando.
  /// Ej: "F24" si la original era "F24-001".
  rectifiedInvoiceSeries String?
  /// Número de la factura original. Ej: "F24-001".
  rectifiedInvoiceNumber String?
  /// Tipo de rectificación. Lo pide A3 en la columna "Tipo Rectificativa"
  /// si exportamos a un mapping extendido.
  rectificativeType      RectificativeType?
  /// Casos especiales: concursos de acreedores o créditos incobrables
  /// (Art. 80.Tres de la Ley del IVA). Muy raro pero hay que tenerlo.
  art80Tres              Boolean   @default(false)

  // Cuentas contables asignadas (del plan de cuentas)
  supplierAccount String?   // Cuenta proveedor 400.xxxxx / 410.xxxxx
  expenseAccount  String?   // Cuenta gasto/ingreso 6xx.xxxxx / 7xx.xxxxx

  // Gestion de estado avanzada
  rejectionReason   String?
  rejectionCategory RejectionCategory?
  reviewedBy        String?

  // Re-subida: vincula con la factura rechazada original
  replacesId String?  @unique
  replaces   Invoice? @relation("ReplacedBy", fields: [replacesId], references: [id])
  replacedBy Invoice? @relation("ReplacedBy")

  // Periodo contable (puede diferir del periodo de subida)
  accountingPeriodMonth Int?
  accountingPeriodYear  Int?
  ocrAttempts     Int       @default(0)
  lastOcrError    String?

  /// Marca de "posponer": el gestor decidió saltarse esta factura para
  /// más tarde sin cambiar su estado. La cola de revisión ordena las
  /// pospuestas al final, así no estorban al flujo principal. Se limpia
  /// automáticamente cuando alguien la edita o valida.
  deferredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId      String
  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  documentId    String?
  document      Document?  @relation(fields: [documentId], references: [id])

  auditLogs     AuditLog[]
  extractions   InvoiceExtraction[]
  statusHistory InvoiceStatusHistory[]
  issues        InvoiceIssue[]
  exportBatchItems ExportBatchItem[]
  vatLines      InvoiceVatLine[]

  exportBatchId String?
  exportBatch   ExportBatch? @relation(fields: [exportBatchId], references: [id])

  @@index([clientId, status])
  @@index([issuerCif])
  @@index([periodMonth, periodYear])
}

/// Desglose de bases/cuotas de IVA. Una factura puede tener varias lineas
/// (p.ej. supermercado: 4% + 10% + 21%). Los campos taxBase/vatAmount de
/// Invoice son la SUMA de las lineas (denormalizados para listados).
/// Invoice.vatRate solo tiene valor cuando hay una unica linea.
model InvoiceVatLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  position  Int      // orden de presentacion (0,1,2...)
  taxBase   Decimal  @db.Decimal(12, 2)
  vatRate   Decimal  @db.Decimal(5, 2)
  vatAmount Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceExtraction {
  id        String @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Datos brutos extraidos por OCR
  rawResponse   String?   // JSON completo de respuesta OCR
  source        String    // "document_ai" | "xml_parse" | "manual"
  confidence    Json?     // { campo: 0.0-1.0 } scores de confianza OCR

  // OCR job tracking
  ocrStartedAt  DateTime?  // Inicio del procesamiento OCR
  ocrFinishedAt DateTime?  // Fin del procesamiento (exito o error)
  ocrDurationMs Int?       // Duracion en milisegundos
  isReprocess   Boolean    @default(false) // true si fue reproceso manual
  issuerName    String?
  issuerCif     String?
  receiverName  String?
  receiverCif   String?
  invoiceNumber String?
  invoiceDate   DateTime?
  taxBase       Decimal?  @db.Decimal(12, 2)
  vatRate       Decimal?  @db.Decimal(5, 2)
  vatAmount     Decimal?  @db.Decimal(12, 2)
  irpfRate      Decimal?  @db.Decimal(5, 2)
  irpfAmount    Decimal?  @db.Decimal(12, 2)
  totalAmount   Decimal?  @db.Decimal(12, 2)
  isValid       Boolean?

  createdAt DateTime @default(now())
}

model InvoiceStatusHistory {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  fromStatus InvoiceStatus?
  toStatus   InvoiceStatus
  reason     String?
  changedBy  String?

  createdAt DateTime @default(now())
}

model ExportBatch {
  id           String   @id @default(cuid())
  format       String   // "sage50" | "contasol" | "a3con"
  clientId     String?
  periodMonth  Int?
  periodYear   Int?
  invoiceType  String?  // "ALL" | "PURCHASE" | "SALE"
  invoiceCount Int
  userId       String
  createdAt    DateTime @default(now())

  invoices Invoice[]
  items    ExportBatchItem[]
}

model ExportBatchItem {
  id            String      @id @default(cuid())
  exportBatchId String
  exportBatch   ExportBatch @relation(fields: [exportBatchId], references: [id], onDelete: Restrict)
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  snapshot      String      // JSON snapshot de los datos de la factura al exportar
  createdAt     DateTime    @default(now())

  @@unique([exportBatchId, invoiceId])
}

model InvoiceIssue {
  id          String      @id @default(cuid())
  invoiceId   String
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  type        IssueType
  status      IssueStatus @default(OPEN)
  description String
  field       String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
}

/// Registro de cambios append-only con cadena de hash.
///
/// Cada registro contiene el hash del anterior (`prevHash`) y su propio
/// hash (`hash`). Si alguien borra o modifica una fila — incluso desde
/// la consola de Supabase — la cadena se rompe y `verifyAuditChain()`
/// lo detecta inmediatamente.
///
/// Ademas hay un trigger PostgreSQL que bloquea UPDATE/DELETE a nivel
/// BD (ver migracion). Por eso los desarrolladores tampoco pueden
/// alterar el historial.
model AuditLog {
  id        String   @id @default(cuid())
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// id del registro anterior en la cadena. NULL solo para el primero
  /// de cada factura ("genesis" del chain por factura).
  prevId    String?
  /// Hash del registro anterior. "GENESIS" para el primero.
  prevHash  String   @default("GENESIS")
  /// Hash de este registro (sha256 hex de los campos + prevHash).
  hash      String

  @@index([invoiceId, createdAt])
  @@index([prevId])
}

model PeriodClosure {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  closedBy    String
  closedAt    DateTime @default(now())
  reopenedAt  DateTime?
  reopenedBy  String?
  reminderSent Boolean @default(false)

  @@unique([clientId, month, year])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AccountEntry {
  id              String   @id @default(cuid())
  nif             String
  name            String
  supplierAccount String   // Cuenta proveedor 400.xxxxx / 410.xxxxx
  expenseAccount  String   // Cuenta gasto/ingreso 6xx.xxxxx / 7xx.xxxxx
  defaultVatRate  Decimal? @db.Decimal(5, 2)
  /// Tipo de operación fiscal por defecto para este NIF. Se aprende al
  /// validar la primera factura: si el gestor cambia el tipo (ej. detecta
  /// que es Inversión SP), la próxima factura del mismo NIF la
  /// pre-rellena automáticamente. null = sin aprender aún.
  defaultOperationType OperationType?
  /// Tipo y % de retención IRPF aprendidos de validaciones previas.
  /// Si un proveedor SIEMPRE emite con retención de profesional al 15%,
  /// la próxima factura suya se pre-rellena con esos valores.
  defaultRetentionType RetentionType?
  defaultRetentionRate Decimal?       @db.Decimal(5, 2)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, nif])
  @@index([clientId])
}
